# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# macOS app-bundle build artifacts (the generated icon; PyInstaller build/ and dist/ are above)
packaging/icon.icns
packaging/icon.iconset/

# Virtual environments
.venv

# Logs
logs/

# Local SQLite cache written at the repo root during manual runs
# (plus its WAL/SHM/lock sidecars)
/cache.sqlite*

# Test coverage
.coverage
lcov.info

# sonar-scanner working directory
.scannerwork

# Generated CI artifacts (coverage.xml, ruff/bandit reports, scan logs)
reports/

# Machine-local Claude Code settings (hooks, permissions, enabled MCP servers)
.claude/settings.local.json

# Zensical documentation build output and cache (see zensical.toml)
site/
.cache/

# marimo notebook session cache (written next to telemetry/dashboard.py on run)
__marimo__/

# OpenTofu for the telemetry collector: provider downloads and the local state. The state is
# encrypted, but it holds the values of the tokens it creates, so it stays out of git as well. The
# lock file (.terraform.lock.hcl) is committed.
telemetry/infra/.terraform/
telemetry/infra/*.tfstate
telemetry/infra/*.tfstate.*
telemetry/infra/crash.log
# Wrangler's local cache, written next to wrangler.toml by any wrangler command.
telemetry/.wrangler/
