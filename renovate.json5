// Renovate configuration: automated dependency updates across pyproject.toml / uv.lock, GitHub
// Actions (.github/workflows), and prek.toml hook revs.
//
// Setup: install the Renovate GitHub App (https://github.com/apps/renovate) and merge the one-time
// "Configure Renovate" onboarding PR. Renovate's GitHub-sourced security PRs need the repo's
// Dependency graph + Dependabot alerts enabled (Settings -> Security). This file replaces the old
// .github/dependabot.yml.
//
// Validate after editing: `npx --yes --package renovate -- renovate-config-validator --strict`
// (also wired as a pre-commit hook).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // config:best-practices applies this repo's policy by default: GitHub Actions pinned to a full
  // commit SHA (with the version kept in the trailing comment). It also enables the Dependency
  // Dashboard issue. The built-in pre-commit manager is deliberately NOT enabled: it only looks at
  // .pre-commit-config.ya?ml, and this repo uses prek.toml. See customManagers below.
  extends: ["config:best-practices"],

  // best-practices does NOT refresh transitive pins on its own; without this, uv.lock entries
  // that no direct constraint covers only ever move via security alerts. Uses the same weekly
  // window as the schedule below.
  lockFileMaintenance: { enabled: true },

  timezone: "Europe/Berlin",

  // Cron (the minute field must be "*"): a Monday 02:00-06:59 window. The window only *allows* PRs
  // to open; the hosted App decides when it actually runs.
  schedule: ["* 2-6 * * 1"],

  // Bump the lower bound in pyproject.toml instead of only updating uv.lock. With the default
  // "auto" strategy an open ">=" range still covers a new release, so Renovate would touch only
  // uv.lock and leave the constraint stale. "bump" raises "cyclopts>=4.16.1" to "cyclopts>=4.17.0"
  // (and updates uv.lock), keeping the declared floor in sync with what is installed. Ignored by
  // the github-actions manager and the prek.toml regex manager, which pin exact SHAs/revs.
  rangeStrategy: "bump",

  // Hold a non-security release for 1 day before opening a PR. This also keeps Renovate compatible
  // with "[tool.uv] exclude-newer" in pyproject.toml: uv refuses to lock an artifact younger than
  // 1 day, so proposing anything newer would yield an unresolvable "uv lock" PR.
  minimumReleaseAge: "1 days",

  // Security fixes open immediately, bypassing the weekly window and the 1-day hold. The pinned
  // minimumReleaseAge keeps that bypass even with a global value set above. osvVulnerabilityAlerts
  // adds OSV.dev coverage for the Python dependencies.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
    minimumReleaseAge: "0 days",
  },

  labels: ["dependencies"],

  // prek reads prek.toml, not .pre-commit-config.yaml. Renovate has no native prek manager yet
  // (renovatebot/renovate#41683), and the built-in pre-commit manager is hardwired to
  // .pre-commit-config.ya?ml, so without this regex manager the hook revs below would silently go
  // stale. Drop this block once a native manager ships and matches prek.toml directly.
  customManagers: [
    {
      customType: "regex",
      description: "prek hook revs in prek.toml",
      managerFilePatterns: ["/(^|/)prek\\.toml$/"],
      // Captures the owner/repo slug and the rev that follows it. "[^\\[]*?" tolerates comments or
      // blank lines between the two keys while refusing to cross into the next "[[repos]]" table,
      // so a rev is never paired with the wrong repo. The local hooks have no rev and never match.
      matchStrings: [
        "repo\\s*=\\s*[\"']https://github\\.com/(?<packageName>[^\"'\\s]+?)(?:\\.git)?[\"'][^\\[]*?rev\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']",
      ],
      // The slug is both what github-tags queries and what the packageRules below match on.
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "The wrangler version the telemetry deploy pins",
      managerFilePatterns: ["/(^|/)\\.github/workflows/deploy-telemetry\\.yml$/"],
      matchStrings: ["wranglerVersion:\\s*[\"'](?<currentValue>[^\"']+)[\"']"],
      depNameTemplate: "wrangler",
      datasourceTemplate: "npm",
    },
  ],

  // PR titles read "build(deps): ...".
  semanticCommits: "enabled",
  semanticCommitType: "build",
  semanticCommitScope: "deps",

  packageRules: [
    // The collector's infrastructure (telemetry/infra) runs on OpenTofu, and its lock file names
    // the OpenTofu registry. Renovate assumes the Terraform registry unless told otherwise.
    {
      description: "Look up providers and modules in the OpenTofu registry",
      matchDatasources: ["terraform-provider", "terraform-module"],
      registryUrls: ["https://registry.opentofu.org"],
    },
    // Renovate reads required_version against the Terraform releases, and OpenTofu's version
    // numbers are its own (Terraform 1.16 is no OpenTofu release), so it would raise the floor to a
    // version tofu refuses. The floor is the oldest OpenTofu with the encryption the state needs.
    {
      description: "Do not bump the OpenTofu required_version",
      matchManagers: ["terraform"],
      matchDepTypes: ["required_version"],
      enabled: false,
    },
    // requires-python is a deliberate minimum-supported-version decision, not a routine dependency
    // floor: bumping it to the latest patch (e.g. >=3.14,<4 -> >=3.14.7,<4) would needlessly narrow
    // who can install the package. "replace" is what holds it back: the global "bump" strategy
    // above would otherwise raise the floor even though the range already covers the new release.
    // dependencyDashboardApproval alone gates the pull request, not the lookup, so a
    // --platform=local run would still report the bump. It still matters for a release outside the
    // range (Python 4), which then waits as a dashboard checkbox instead of opening a PR.
    {
      description: "Do not auto-bump the requires-python floor",
      matchManagers: ["pep621"],
      matchDepTypes: ["requires-python"],
      rangeStrategy: "replace",
      dependencyDashboardApproval: true,
    },

    // --- Ecosystem grouping: batch minor+patch, let majors land alone for their own review. ---
    {
      description: "GitHub Actions: group minor+patch",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "github-actions (minor+patch)",
    },
    {
      description: "Python runtime deps [project.dependencies]: group minor+patch",
      matchManagers: ["pep621"],
      matchDepTypes: ["project.dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "python production (minor+patch)",
    },
    {
      // PEP 735 groups all share the single depType "dependency-groups", so this covers dev and
      // test together.
      description: "Python dev/test deps [dependency-groups]: group minor+patch",
      matchManagers: ["pep621"],
      matchDepTypes: ["dependency-groups"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "python development (minor+patch)",
    },

    // --- Batch every remaining prek hook bump into one PR. The tool-specific groups below
    //     come AFTER this and override it for ruff/bandit (last matching rule wins). ---
    {
      description: "prek hooks without a cross-file twin",
      matchManagers: ["custom.regex"],
      groupName: "prek hooks",
    },

    // --- Cross-file version sync. Renovate names a prek hook by its repo slug
    //     (astral-sh/ruff-pre-commit) and a PyPI dep by package name (ruff). They never collide, so
    //     a shared groupName pulls each tool's occurrences into ONE PR. No matchUpdateTypes filter:
    //     the hook and the dep must move together on every bump, majors included. Each occurrence
    //     tracks the same upstream release tags, so within the PR they converge to one version. ---
    {
      description: "ruff: pyproject dep + ruff-pre-commit hook",
      matchPackageNames: ["ruff", "astral-sh/ruff-pre-commit"],
      groupName: "ruff",
    },
    {
      description: "bandit: pyproject dep (extras stripped to 'bandit') + PyCQA/bandit hook",
      matchPackageNames: ["bandit", "PyCQA/bandit"],
      groupName: "bandit",
    },
  ],
}
