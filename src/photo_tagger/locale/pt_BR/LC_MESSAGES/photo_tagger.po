msgstr "(mantém o aviso que tem)"

#: src/photo_tagger/gui/detail_pane.py:480
msgid "(not written)"
msgstr "(não gravado)"

#: src/photo_tagger/gui/detail_pane.py:486
msgid "(no preview available)"
msgstr "(sem visualização disponível)"

#: src/photo_tagger/gui/detail_pane.py:534
