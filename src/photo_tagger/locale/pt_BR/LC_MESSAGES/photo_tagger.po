msgstr "Quais campos um salvamento substitui quando a foto já tem um."

#: src/photo_tagger/gui/save_options.py:201
msgid "Write To"
msgstr "Gravar em"

#: src/photo_tagger/gui/save_options.py:203
msgid "Where a save puts the metadata."
msgstr "Onde o salvamento coloca os metadados."

#: src/photo_tagger/gui/save_options.py:217
#, python-brace-format
