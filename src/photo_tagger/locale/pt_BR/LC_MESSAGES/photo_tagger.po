#: src/photo_tagger/gui.py:397
msgid "(none)"
msgstr "(nenhum)"

#: src/photo_tagger/gui.py:400
msgid "Could not save the config file"
msgstr "Não foi possível salvar o arquivo de configuração"

#: src/photo_tagger/gui.py:403
msgid "Pick at least one field to write (Title, Description, or Keywords)."
msgstr ""
"Escolha ao menos um campo para gravar (Título, Descrição ou Palavras-"
"chave)."

#: src/photo_tagger/gui.py:407
msgid "Choose..."
msgstr "Escolher..."

#: src/photo_tagger/gui.py:408
msgid "Close"
msgstr "Fechar"

#: src/photo_tagger/gui.py:414
msgid ""
"Add photos to get started.\n"
"\n"
"Drag photos or folders onto the window, or use the Add Photos button."
msgstr ""
"Adicione fotos para começar.\n"
"\n"
"Arraste fotos ou pastas para a janela, ou use o botão Adicionar Fotos."

#: src/photo_tagger/gui.py:418
msgid ""
"Select a photo to review it.\n"
"\n"
"Generate proposes a title, description, and keywords you can edit before "
"saving."
msgstr ""
"Selecione uma foto para revisá-la.\n"
"\n"
"Gerar propõe um título, uma descrição e palavras-chave que você pode "
"editar antes de salvar."

#: src/photo_tagger/gui.py:425
msgid "working..."
msgstr "processando..."

#: src/photo_tagger/gui.py:426
msgid "ready"
msgstr "pronto"

#: src/photo_tagger/gui.py:427
msgid "saved ✓"
msgstr "salvo ✓"

#: src/photo_tagger/gui.py:428
msgid "failed ✗"
msgstr "falhou ✗"

#: src/photo_tagger/gui.py:438
msgid "Has any metadata"
msgstr "Tem algum metadado"

#: src/photo_tagger/gui.py:442
msgid "any metadata"
msgstr "algum metadado"

#: src/photo_tagger/gui.py:446
msgid "Has a title"
msgstr "Tem título"

#: src/photo_tagger/gui.py:450
msgid "a title"
msgstr "título"

#: src/photo_tagger/gui.py:454
msgid "Has a description"
msgstr "Tem descrição"

#: src/photo_tagger/gui.py:458
msgid "a description"
msgstr "descrição"

#: src/photo_tagger/gui.py:462
msgid "Has a title and a description"
msgstr "Tem título e descrição"

#: src/photo_tagger/gui.py:466
msgid "a title and a description"
msgstr "título e descrição"

#: src/photo_tagger/gui.py:470
msgid "Has keywords"
msgstr "Tem palavras-chave"

#: src/photo_tagger/gui.py:474 src/photo_tagger/gui.py:3885
#: src/photo_tagger/gui_state.py:1823
msgid "keywords"
msgstr "palavras-chave"

#: src/photo_tagger/gui.py:494
msgid "View as Tree"
msgstr "Ver como Árvore"

#: src/photo_tagger/gui.py:495
msgid "Group each photo under the folder it came from."
msgstr "Agrupa cada foto sob a pasta de onde ela veio."

#: src/photo_tagger/gui.py:499
msgid "View as List"
msgstr "Ver como Lista"

#: src/photo_tagger/gui.py:501
msgid ""
"List every photo at one level, so clicking Status or Type sorts the whole"
" list rather than each folder on its own. Folder rows (and their "
"checkboxes) are gone while it is on; a photo's folder still opens from Go"
" > Enclosing Folder."
msgstr ""
"Lista todas as fotos em um único nível, em vez de agrupá-las por pasta, "
"para que clicar em Status ou Tipo ordene a lista inteira e não cada pasta"
" separadamente. As linhas de pasta (e suas caixas de seleção) somem "
"enquanto estiver ativo; a pasta de uma foto continua acessível em Ir > "
"Pasta Acima."

#: src/photo_tagger/gui.py:513
msgid "Check"
msgstr "Marcar"

#: src/photo_tagger/gui.py:514
msgid "Check the matching photos, leaving every other photo as it is."
msgstr "Marca as fotos correspondentes, deixando todas as outras como estão."

#: src/photo_tagger/gui.py:518
msgid "Uncheck"
msgstr "Desmarcar"

#: src/photo_tagger/gui.py:519
msgid "Uncheck the matching photos, leaving every other photo as it is."
msgstr "Desmarca as fotos correspondentes, deixando todas as outras como estão."

#: src/photo_tagger/gui.py:523
msgid "Check Only"
msgstr "Marcar Apenas"

#: src/photo_tagger/gui.py:524
msgid "Check the matching photos and uncheck every other photo in the list."
msgstr "Marca as fotos correspondentes e desmarca todas as outras da lista."

#: src/photo_tagger/gui.py:532 src/photo_tagger/gui.py:3517
msgid "Not generated"
msgstr "Não geradas"

#: src/photo_tagger/gui.py:533 src/photo_tagger/gui.py:3518
msgid "Generated"
msgstr "Geradas"

#: src/photo_tagger/gui.py:534 src/photo_tagger/gui.py:3519
msgid "Saved"
msgstr "Salvas"

#: src/photo_tagger/gui.py:535 src/photo_tagger/gui.py:3520
msgid "Failed"
msgstr "Com falha"

#: src/photo_tagger/gui.py:536 src/photo_tagger/gui.py:3521
msgid "Untagged"
msgstr "Sem etiquetas"

#: src/photo_tagger/gui.py:537 src/photo_tagger/gui.py:3522
msgid "Mixed writing systems"
msgstr "Sistemas de escrita misturados"

#: src/photo_tagger/gui.py:545
msgid "XMP Sidecar"
msgstr "Sidecar XMP"

#: src/photo_tagger/gui.py:546
msgid "Write a .xmp file next to every photo, leaving the photos untouched."
msgstr "Grava um arquivo .xmp ao lado de cada foto, sem alterar as fotos."

#: src/photo_tagger/gui.py:550
msgid "The Photo Itself"
msgstr "A Própria Foto"

#: src/photo_tagger/gui.py:551
msgid "Write into every image file, creating no sidecars."
msgstr "Grava dentro de cada arquivo de imagem, sem criar sidecars."

#: src/photo_tagger/gui.py:555
msgid "Sidecar for RAW, Photo Otherwise"
msgstr "Sidecar para RAW, Foto nos Demais"

#: src/photo_tagger/gui.py:557
msgid ""
"Write a .xmp file beside each RAW photo and write into everything else. "
"For a folder of RAW+JPEG pairs."
msgstr ""
"Grava um arquivo .xmp ao lado de cada foto RAW e grava dentro de todas as"
" outras. Para uma pasta com pares RAW+JPEG."

#: src/photo_tagger/gui.py:563
msgid "Both, Photo and Sidecar"
msgstr "Ambos, Foto e Sidecar"

#: src/photo_tagger/gui.py:565
msgid ""
"Write into every photo and put the same metadata in a .xmp beside it. "
"Twice the writes, and the photo travels tagged even where the sidecar is "
"left behind."
msgstr ""
"Grava dentro de cada foto e põe os mesmos metadados em um .xmp ao lado. "
"São duas gravações, e a foto viaja com os metadados mesmo onde o sidecar "
"fica para trás."

#: src/photo_tagger/gui.py:577 src/photo_tagger/gui.py:3659
msgid "Title"
msgstr "Título"

#: src/photo_tagger/gui.py:578
msgid "Replace an existing title. Uncheck to fill in only photos without one."
msgstr ""
"Substitui um título existente. Desmarque para preencher apenas as fotos "
"sem um."

#: src/photo_tagger/gui.py:582 src/photo_tagger/gui.py:3675
msgid "Description"
msgstr "Descrição"

#: src/photo_tagger/gui.py:584
msgid ""
"Replace an existing description. Uncheck to fill in only photos without "
"one."
msgstr ""
"Substitui uma descrição existente. Desmarque para preencher apenas as "
"fotos sem uma."

#: src/photo_tagger/gui.py:589 src/photo_tagger/gui.py:3692
msgid "Keywords"
msgstr "Palavras-chave"

#: src/photo_tagger/gui.py:590
msgid "Replace existing keywords instead of merging the new ones in."
msgstr "Substitui as palavras-chave existentes em vez de mesclar as novas."

#: src/photo_tagger/gui.py:606
msgid ""
"The copyright sign. XMP is UTF-8 and carries it. EXIF types its copyright"
" field as ASCII before Exif 3.0, so '(c)' is the safe spelling for the "
"notice."
msgstr ""
"O símbolo de copyright. XMP é UTF-8 e o carrega. O EXIF define o campo de"
" copyright como ASCII antes do Exif 3.0, então '(c)' é a grafia segura "
"para o aviso."

#: src/photo_tagger/gui.py:612
msgid "The year the photo was taken, from its capture date."
msgstr "O ano em que a foto foi tirada, vindo da data de captura dela."

#: src/photo_tagger/gui.py:616
msgid "The name in the Creator field above."
msgstr "O nome no campo Criador acima."

#: src/photo_tagger/gui.py:623
msgid "Leave as is"
msgstr "Deixar como está"

#: src/photo_tagger/gui.py:624
msgid "Under copyright"
msgstr "Com direitos autorais"

#: src/photo_tagger/gui.py:625
msgid "Public domain"
msgstr "Domínio público"

#: src/photo_tagger/gui.py:631
msgid "to an XMP sidecar"
msgstr "em um sidecar XMP"

#: src/photo_tagger/gui.py:632
msgid "into the image file"
msgstr "no arquivo de imagem"

#: src/photo_tagger/gui.py:633
msgid "to a sidecar for RAW, into the image file otherwise"
msgstr "em um sidecar XMP para RAW e no arquivo de imagem nos demais"

#: src/photo_tagger/gui.py:634
msgid "into the image file and an XMP sidecar"
msgstr "no arquivo de imagem e em um sidecar XMP"

#: src/photo_tagger/gui.py:1433
msgid "No keywords found: there is nothing to build a vocabulary from."
msgstr ""
"Nenhuma palavra-chave encontrada: não há nada com que construir um "
"vocabulário."

#: src/photo_tagger/gui.py:1462
#, python-brace-format
msgid "Wrote {kept} keyword(s) to {file}, dropped {dropped}."
msgstr "{kept} palavra(s)-chave gravada(s) em {file}, {dropped} descartada(s)."

#: src/photo_tagger/gui.py:1476
#, python-brace-format
msgid "Reading {file}..."
msgstr "Lendo {file}..."

#: src/photo_tagger/gui.py:1486
#, python-brace-format
msgid "Reading the keywords on {n} photo..."
msgid_plural "Reading the keywords on {n} photos..."
msgstr[0] "Lendo as palavras-chave de {n} foto..."
msgstr[1] "Lendo as palavras-chave de {n} fotos..."

#: src/photo_tagger/gui.py:1499
#, python-brace-format
msgid "Organizing {n} keyword(s) with {model}..."
msgstr "Organizando {n} palavra(s)-chave com {model}..."

#: src/photo_tagger/gui.py:1675
msgid "Zoom out"
msgstr "Reduzir"

#: src/photo_tagger/gui.py:1682
msgid "Zoom in"
msgstr "Ampliar"

#: src/photo_tagger/gui.py:1685
msgid "Fit"
msgstr "Ajustar"

#: src/photo_tagger/gui.py:1686
msgid "Scale the photo to the window (Ctrl+0)."
msgstr "Ajusta a foto ao tamanho da janela (Ctrl+0)."

#: src/photo_tagger/gui.py:1689
msgid "100%"
msgstr "100%"

#: src/photo_tagger/gui.py:1690
msgid "Show the photo at one screen pixel per image pixel (Ctrl+1)."
msgstr "Mostra a foto com um pixel de tela para cada pixel da imagem (Ctrl+1)."

#: src/photo_tagger/gui.py:1694
msgid "Scroll to pan · Ctrl+scroll or +/- to zoom · double-click to toggle fit"
msgstr ""
"Role para mover · Ctrl+rolagem ou +/- para ampliar · clique duplo alterna"
" o ajuste"

#: src/photo_tagger/gui.py:1698
msgid "Full screen"
msgstr "Tela cheia"

#: src/photo_tagger/gui.py:1699
msgid "Fill the whole screen, hiding the window frame (F)."
msgstr "Ocupa a tela inteira, escondendo a moldura da janela (F)."

#: src/photo_tagger/gui.py:2087
msgid "Back"
msgstr "Voltar"

#: src/photo_tagger/gui.py:2088
msgid "Forward"
msgstr "Avançar"

#: src/photo_tagger/gui.py:2091
msgid "Enclosing Folder"
msgstr "Pasta Acima"

#: src/photo_tagger/gui.py:2122
msgid "File"
msgstr "Arquivo"

#: src/photo_tagger/gui.py:2123 src/photo_tagger/gui.py:2775
msgid "Add Photos..."
msgstr "Adicionar Fotos..."

#: src/photo_tagger/gui.py:2124 src/photo_tagger/gui.py:2935
msgid "Add Folder..."
msgstr "Adicionar Pasta..."

#: src/photo_tagger/gui.py:2126
msgid "Export CSV Report..."
msgstr "Exportar Relatório CSV..."

#: src/photo_tagger/gui.py:2129
msgid ""
"Save a CSV report of every photo: generated and existing metadata, EXIF, "
"and token usage."
msgstr ""
"Salva um relatório CSV de todas as fotos: metadados gerados e existentes,"
" EXIF e uso de tokens."

#: src/photo_tagger/gui.py:2134
msgid "Clear List"
msgstr "Limpar Lista"

#: src/photo_tagger/gui.py:2136
msgid "Quit"
msgstr "Sair"

#: src/photo_tagger/gui.py:2144
msgid "Help"
msgstr "Ajuda"

#: src/photo_tagger/gui.py:2146
msgid "Documentation"
msgstr "Documentação"

#: src/photo_tagger/gui.py:2150 src/photo_tagger/gui.py:2671
msgid "Test Connection"
msgstr "Testar Conexão"

#: src/photo_tagger/gui.py:2151
msgid "Open Logs"
msgstr "Abrir Logs"

#: src/photo_tagger/gui.py:2153 src/photo_tagger/gui.py:2588
msgid "About Photo Tagger"
msgstr "Sobre o Photo Tagger"

#: src/photo_tagger/gui.py:2163
msgid "Go"
msgstr "Ir"

#: src/photo_tagger/gui.py:2169
msgid "Show the thumbnail grid of the folder holding the open photo."
msgstr "Mostra a grade de miniaturas da pasta que contém a foto aberta."

#: src/photo_tagger/gui.py:2175
msgid "Settings"
msgstr "Configurações"

#: src/photo_tagger/gui.py:2177
msgid "Cache AI Results"
msgstr "Armazenar Resultados de IA em Cache"

#: src/photo_tagger/gui.py:2182
#, python-brace-format
msgid ""
"Reuse earlier results for unchanged photos ({cache_file}). Uncheck to "
"call the model again for everything; a single photo can skip the cache "
"from its right-click menu."
msgstr ""
"Reutiliza resultados anteriores para fotos inalteradas ({cache_file}). "
"Desmarque para chamar o modelo novamente para tudo; uma única foto pode "
"ignorar o cache pelo menu de clique direito."

#: src/photo_tagger/gui.py:2189
msgid "Send Anonymous Telemetry"
msgstr "Enviar Telemetria Anônima"

#: src/photo_tagger/gui.py:2194
msgid ""
"Anonymous usage stats (model, batch size, OS, CPU/GPU model, RAM, timing)"
" and crash reports (error type and code location only). No photos, error "
"messages, or personal data."
msgstr ""
"Estatísticas de uso anônimas (modelo, tamanho do lote, SO, modelo de "
"CPU/GPU, RAM, tempos) e relatórios de falha (apenas tipo de erro e local "
"no código). Nenhuma foto, mensagem de erro ou dado pessoal."

#: src/photo_tagger/gui.py:2201
msgid "Record Saves for Undo"
msgstr "Registrar Gravações para Desfazer"

#: src/photo_tagger/gui.py:2206
msgid ""
"Record every file a save writes, so Tools > Undo Writes can put it back. "
"On by default: the saves worth undoing are the ones nobody planned to."
msgstr ""
"Registra cada arquivo que uma gravação escreve, para que Ferramentas > "
"Desfazer Gravações possa restaurá-lo. Ativado por padrão: as gravações "
"que vale a pena desfazer são as que ninguém planejou."

#: src/photo_tagger/gui.py:2215
msgid "Keyword Rules..."
msgstr "Regras de Palavras-chave..."

#: src/photo_tagger/gui.py:2220
msgid ""
"The controlled vocabulary generated keywords are snapped onto, and "
"whether the keywords of one shoot are made to agree with each other."
msgstr ""
"O vocabulário controlado ao qual as palavras-chave geradas são ajustadas,"
" e se as palavras-chave de uma mesma sessão são harmonizadas entre si."

#: src/photo_tagger/gui.py:2224
msgid "Copyright..."
msgstr "Direitos autorais..."

#: src/photo_tagger/gui.py:2227
msgid ""
"Your credit and copyright notice, written by every save. The year comes "
"from each photo, so one setting covers every shoot."
msgstr ""
"Seu crédito e seu aviso de direitos autorais, gravados em todo "
"salvamento. O ano vem de cada foto, então um ajuste só vale para todos os"
" ensaios."

#: src/photo_tagger/gui.py:2231
msgid "Pacing..."
msgstr "Ritmo..."

#: src/photo_tagger/gui.py:2234
msgid ""
"Rest a long run now and then, so it does not flatten the battery, cook "
"the machine, or take it over while you work."
msgstr ""
"Faz uma execução longa descansar de vez em quando, para não esgotar a "
"bateria, esquentar a máquina ou tomá-la enquanto você trabalha."

#: src/photo_tagger/gui.py:2243
msgid "Save Settings as Defaults..."
msgstr "Salvar Configurações como Padrão..."

#: src/photo_tagger/gui.py:2248
msgid ""
"Update the config file with the current provider, model, URL, file types,"
" and save options. Other settings and comments in the file are preserved;"
" the API key is never written."
msgstr ""
"Atualiza o arquivo de configuração com o provedor, modelo, URL, tipos de "
"arquivo e opções de gravação atuais. As demais configurações e "
"comentários do arquivo são preservados; a chave de API nunca é gravada."

#: src/photo_tagger/gui.py:2253
msgid "Edit Config File..."
msgstr "Editar Arquivo de Configuração..."

#: src/photo_tagger/gui.py:2256
msgid ""
"Open the config file in your default editor for the settings the GUI does"
" not surface (prompt file, sampling, workers, filters, ...). Created if "
"missing."
msgstr ""
"Abre o arquivo de configuração no seu editor padrão para as opções que a "
"interface não expõe (arquivo de prompt, amostragem, workers, filtros, "
"...). Criado se não existir."

#: src/photo_tagger/gui.py:2263
msgid "Rewrite Mixed-Language Output"
msgstr "Reescrever Saída com Idiomas Misturados"

#: src/photo_tagger/gui.py:2268
msgid ""
"When the model answers in two writing systems, ask it again for the "
"output language ('Ocarina' for a stray '陶笛'). Costs one extra call per "
"affected photo. Off by default; those photos are marked either way."
msgstr ""
"Quando o modelo responde em dois sistemas de escrita, pedir de novo no "
"idioma de saída ('Ocarina' no lugar de um '陶笛' solto). Custa uma chamada "
"extra por foto afetada. Desligado por padrão; essas fotos são marcadas de"
" todo jeito."

#: src/photo_tagger/gui.py:2282
msgid "Notify When a Run Ends"
msgstr "Notificar Quando uma Execução Terminar"

#: src/photo_tagger/gui.py:2287
msgid ""
"Raise a desktop notification when a generation or save run finishes, so a"
" long batch can be started and left alone. Uses the notifier your system "
"already has; nothing is shown if it has none."
msgstr ""
"Mostra uma notificação da área de trabalho quando uma geração ou gravação"
" termina, para que um lote longo possa ser iniciado e deixado sozinho. "
"Usa o notificador que o seu sistema já tem; nada é mostrado se ele não "
"tiver nenhum."

#: src/photo_tagger/gui.py:2294
msgid "Play a Sound With Notifications"
msgstr "Tocar um Som com as Notificações"

#: src/photo_tagger/gui.py:2299
msgid "Play the system alert sound with the notification."
msgstr "Toca o som de alerta do sistema junto com a notificação."

#: src/photo_tagger/gui.py:2325
msgid "Tools"
msgstr "Ferramentas"

#: src/photo_tagger/gui.py:2328
msgid "Build Vocabulary..."
msgstr "Construir Vocabulário..."

#: src/photo_tagger/gui.py:2331
msgid ""
"Write a keyword file out of the keywords your photos already carry, which"
" is what the strict vocabulary needs to enforce."
msgstr ""
"Gera um arquivo de palavras-chave a partir das que suas fotos já têm, que"
" é o que o vocabulário estrito precisa para ser aplicado."

#: src/photo_tagger/gui.py:2335
msgid "Harmonize Shoots Now"
msgstr "Harmonizar Sessões Agora"

#: src/photo_tagger/gui.py:2338
msgid ""
"Make the keywords of each shoot agree with each other: the spelling and "
"the hierarchy most of the shoot used win for all of it. Runs "
"automatically after every generation once a session gap is set (Settings "
"> Keyword Rules)."
msgstr ""
"Faz as palavras-chave de cada sessão concordarem entre si: a grafia e a "
"hierarquia usadas na maior parte da sessão valem para toda ela. Roda "
"automaticamente depois de cada geração quando há um intervalo de sessão "
"definido (Configurações > Regras de Palavras-chave)."

#: src/photo_tagger/gui.py:2344 src/photo_tagger/gui.py:7048
msgid "Watch Folder..."
msgstr "Monitorar Pasta..."

#: src/photo_tagger/gui.py:2347
msgid ""
"Tag photos as they arrive: point it at the folder your card reader or "
"sync client fills, and each new photo joins the list and is generated for"
" review."
msgstr ""
"Etiqueta as fotos conforme elas chegam: aponte para a pasta que seu "
"leitor de cartão ou cliente de sincronização preenche, e cada foto nova "
"entra na lista e é gerada para revisão."

#: src/photo_tagger/gui.py:2352
msgid "Undo Writes..."
msgstr "Desfazer Gravações..."

#: src/photo_tagger/gui.py:2355
msgid ""
"Put back what a recorded run wrote: sidecars it created are deleted, "
"files it overwrote are restored from the ExifTool backup. Covers CLI runs"
" too."
msgstr ""
"Restaura o que uma execução registrada gravou: os sidecars que ela criou "
"são apagados e os arquivos que ela sobrescreveu são restaurados do backup"
" do ExifTool. Vale também para execuções na linha de comando."

#: src/photo_tagger/gui.py:2362
msgid "Language"
msgstr "Idioma"

#: src/photo_tagger/gui.py:2365
msgid ""
"Language of the app itself (menus, buttons, messages). The language of "
"the generated metadata is set under Metadata Language."
msgstr ""
"Idioma do próprio aplicativo (menus, botões, mensagens). O idioma dos "
"metadados gerados é definido em Idioma dos Metadados."

#: src/photo_tagger/gui.py:2370
msgid "System Default"
msgstr "Padrão do Sistema"

#: src/photo_tagger/gui.py:2396
msgid "Language saved. Restart Photo Tagger to apply it."
msgstr "Idioma salvo. Reinicie o Photo Tagger para aplicá-lo."

#: src/photo_tagger/gui.py:2400 src/photo_tagger/gui.py:2458
msgid "Metadata Language"
msgstr "Idioma dos Metadados"

#: src/photo_tagger/gui.py:2404
msgid ""
"Language of the generated titles, descriptions, and keywords. The "
"language of the app itself is set under Language."
msgstr ""
"Idioma dos títulos, descrições e palavras-chave gerados. O idioma do "
"próprio aplicativo é definido em Idioma."

#: src/photo_tagger/gui.py:2413
msgid "Other..."
msgstr "Outro..."

#: src/photo_tagger/gui.py:2416
msgid ""
"Any language name the model understands works; it is sent to the model as"
" is. Saved to the config file, which the CLI's --output-language default "
"also reads."
msgstr ""
"Qualquer nome de idioma que o modelo entenda funciona; ele é enviado ao "
"modelo como está. Salvo no arquivo de configuração, de onde a CLI também "
"lê o padrão de --output-language."

#: src/photo_tagger/gui.py:2459
msgid "Language for the generated titles, descriptions, and keywords:"
msgstr "Idioma dos títulos, descrições e palavras-chave gerados:"

#: src/photo_tagger/gui.py:2493
#, python-brace-format
msgid "Metadata language set to {language} for the next generation."
