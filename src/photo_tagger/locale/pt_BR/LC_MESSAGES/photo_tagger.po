msgstr "Não foi possível ler essa execução"

#: src/photo_tagger/gui.py:7002 src/photo_tagger/gui_state.py:1578
msgid "That run recorded no writes."
msgstr "Essa execução não registrou nenhuma gravação."

#: src/photo_tagger/gui.py:7014
#, python-brace-format
msgid "Preview: {summary}"
msgstr "Prévia: {summary}"

#: src/photo_tagger/gui.py:7024
