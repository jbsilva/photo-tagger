msgstr "Verifica o ExifTool e se o provedor serve o modelo."

#: src/photo_tagger/gui.py:2466
msgid "Photos"
msgstr "Fotos"

#: src/photo_tagger/gui.py:2466 src/photo_tagger/gui.py:3281
msgid "Type"
msgstr "Tipo"

#: src/photo_tagger/gui.py:2466 src/photo_tagger/gui.py:2748
#: src/photo_tagger/gui.py:3282
msgid "Status"
msgstr "Status"

#: src/photo_tagger/gui.py:2466 src/photo_tagger/gui.py:3283
msgid "Tagged"
msgstr "Etiquetada"

#: src/photo_tagger/gui.py:2485
#, python-brace-format
msgid ""
"Click a column header to sort. Type: file extension, +xmp when a sidecar "
"exists.\n"
"Tagged: metadata already on the file ({legend})."
msgstr ""
"Clique no cabeçalho de uma coluna para ordenar. Tipo: extensão do "
"arquivo, +xmp quando existe um sidecar.\n"
"Etiquetada: metadados já presentes no arquivo ({legend})."

#: src/photo_tagger/gui.py:2501
msgid "Drag photos or folders here. Select one and press Delete to remove it."
msgstr ""
"Arraste fotos ou pastas para cá. Selecione uma e pressione Delete para "
"removê-la."

#: src/photo_tagger/gui.py:2517
msgid "Stop"
msgstr "Parar"

#: src/photo_tagger/gui.py:2520
msgid ""
"Stop reading metadata. The photos already read keep their Tagged column; "
"the rest stay unknown until the next scan. Nothing is written either way."
msgstr ""
"Para a leitura dos metadados. As fotos já lidas mantêm a coluna "
"Etiquetada; as demais ficam desconhecidas até a próxima leitura. Nada é "
"gravado de todo modo."

#: src/photo_tagger/gui.py:2551
msgid ""
"Add photos (click), or open the arrow for adding a whole folder and for "
"the folder-scan options. Dragging files or folders onto the window also "
"works."
msgstr ""
"Adicione fotos (clique) ou abra a seta para adicionar uma pasta inteira e"
" para as opções de varredura de pastas. Arrastar arquivos ou pastas para "
"a janela também funciona."

#: src/photo_tagger/gui.py:2561
msgid "Select"
msgstr "Selecionar"

#: src/photo_tagger/gui.py:2563
msgid "Check or uncheck photos in bulk."
msgstr "Marque ou desmarque fotos em lote."

#: src/photo_tagger/gui.py:2567
msgid "Remove"
msgstr "Remover"

#: src/photo_tagger/gui.py:2569
msgid "Remove the selected folder or photo from the list (or press Delete)."
msgstr "Remove a pasta ou foto selecionada da lista (ou pressione Delete)."

#: src/photo_tagger/gui.py:2580
msgid "Search photos"
msgstr "Buscar fotos"

#: src/photo_tagger/gui.py:2588
msgid ""
"Show only the photos whose name matches. Plain text matches anywhere in "
"the name, and *, ? and [] are wildcards, so *_edit.jpg works. This "
"changes what the list shows, not what a run processes: a hidden photo "
"that is checked is still generated and saved."
msgstr ""
"Mostra apenas as fotos cujo nome corresponde. Texto simples corresponde a"
" qualquer parte do nome, e *, ? e [] são curingas, então *_edit.jpg "
"funciona. Isso muda o que a lista mostra, não o que uma execução "
"processa: uma foto oculta que esteja marcada continua sendo gerada e "
"salva."

#: src/photo_tagger/gui.py:2676
#, python-brace-format
msgid "How the photo list is laid out. Now: {mode}."
msgstr "Como a lista de fotos é organizada. Agora: {mode}."

#: src/photo_tagger/gui.py:2690
msgid ""
"Extensions to scan for in folders (comma-separated).\n"
"Case-insensitive: jpg matches .JPG. Note jpeg is separate from jpg."
msgstr ""
"Extensões a procurar nas pastas (separadas por vírgula).\n"
"Sem distinção de maiúsculas: jpg encontra .JPG. Note que jpeg é separado "
"de jpg."

#: src/photo_tagger/gui.py:2694
msgid "File types"
msgstr "Tipos de arquivo"

#: src/photo_tagger/gui.py:2695 src/photo_tagger/gui.py:5978
