#: src/photo_tagger/gui/common.py:48
msgid "(none)"
msgstr "(nenhum)"

#: src/photo_tagger/gui/common.py:51
msgid "Could not save the config file"
msgstr "Não foi possível salvar o arquivo de configuração"

#: src/photo_tagger/gui/common.py:54
msgid "Pick at least one field to write (Title, Description, or Keywords)."
msgstr ""
"Escolha ao menos um campo para gravar (Título, Descrição ou Palavras-"
"chave)."

#: src/photo_tagger/gui/common.py:58
msgid "Choose..."
msgstr "Escolher..."

#: src/photo_tagger/gui/common.py:59
msgid "Close"
msgstr "Fechar"

#: src/photo_tagger/gui/common.py:63
msgid ""
"Kept for this session. Settings > Save Settings as Defaults writes them "
"to the config file, which CLI runs read too."
msgstr ""
"Mantidas nesta sessão. Configurações > Salvar Configurações como Padrão "
"as grava no arquivo de configuração, que as execuções na linha de comando"
" também leem."

#: src/photo_tagger/gui/connection.py:58
msgid "Backend that serves the vision-language model."
msgstr "Backend que serve o modelo de visão e linguagem."

#: src/photo_tagger/gui/connection.py:66
msgid ""
"Model identifier. Type it, or press Refresh to list what the provider "
"serves."
msgstr ""
"Identificador do modelo. Digite-o ou pressione Atualizar para listar o "
"que o provedor serve."

#: src/photo_tagger/gui/connection.py:69
msgid "Refresh"
msgstr "Atualizar"

#: src/photo_tagger/gui/connection.py:70
msgid "Query the provider for the models it currently serves."
msgstr "Consulta ao provedor os modelos servidos no momento."

#: src/photo_tagger/gui/connection.py:74
msgid "Connection..."
msgstr "Conexão..."

#: src/photo_tagger/gui/connection.py:75
msgid "Server URL, API key, and a connection test."
msgstr "URL do servidor, chave de API e um teste de conexão."

#: src/photo_tagger/gui/connection.py:81
msgid "Provider"
msgstr "Provedor"

#: src/photo_tagger/gui/connection.py:83
msgid "Model"
msgstr "Modelo"

#: src/photo_tagger/gui/connection.py:91
msgid "Connection settings"
msgstr "Configurações de conexão"

#: src/photo_tagger/gui/connection.py:99
msgid "(provider default URL)"
msgstr "(URL padrão do provedor)"

#: src/photo_tagger/gui/connection.py:101
msgid "Provider API base URL. Leave blank to use the provider's default."
msgstr ""
"URL base da API do provedor. Deixe em branco para usar o padrão do "
"provedor."

#: src/photo_tagger/gui/connection.py:103
msgid "Base URL"
msgstr "URL base"

#: src/photo_tagger/gui/connection.py:112
msgid "(uses provider env var)"
msgstr "(usa a variável de ambiente do provedor)"

#: src/photo_tagger/gui/connection.py:115
msgid ""
"API key for the provider. Leave blank to use the provider's environment "
"variable (OPENAI_API_KEY, LM_STUDIO_API_KEY, LLAMA_CPP_API_KEY, or "
"OLLAMA_API_KEY). Required for OpenAI. A typed key is used for this "
"session only and is never written to disk."
msgstr ""
"Chave de API do provedor. Deixe em branco para usar a variável de "
"ambiente do provedor (OPENAI_API_KEY, LM_STUDIO_API_KEY, "
"LLAMA_CPP_API_KEY ou OLLAMA_API_KEY). Obrigatória para a OpenAI. Uma "
"chave digitada vale só para esta sessão e nunca é gravada em disco."

#: src/photo_tagger/gui/connection.py:121
msgid "API key"
msgstr "Chave de API"

#: src/photo_tagger/gui/connection.py:123
#: src/photo_tagger/gui/main_window.py:542
msgid "Test Connection"
msgstr "Testar Conexão"

#: src/photo_tagger/gui/connection.py:125
msgid "Check ExifTool and that the provider serves the model."
msgstr "Verifica o ExifTool e se o provedor serve o modelo."

#: src/photo_tagger/gui/connection.py:163
msgid "Could not list models"
msgstr "Não foi possível listar os modelos"

#: src/photo_tagger/gui/connection.py:171
#, python-brace-format
msgid "Found {n} model on {provider}."
msgid_plural "Found {n} models on {provider}."
msgstr[0] "Encontrado {n} modelo em {provider}."
msgstr[1] "Encontrados {n} modelos em {provider}."

#: src/photo_tagger/gui/connection.py:189
msgid "Connection check"
msgstr "Verificação de conexão"

#: src/photo_tagger/gui/copyright.py:56
msgid ""
"The copyright sign. XMP is UTF-8 and carries it. EXIF types its copyright"
" field as ASCII before Exif 3.0, so '(c)' is the safe spelling for the "
"notice."
msgstr ""
"O símbolo de copyright. XMP é UTF-8 e o carrega. O EXIF define o campo de"
" copyright como ASCII antes do Exif 3.0, então '(c)' é a grafia segura "
"para o aviso."

#: src/photo_tagger/gui/copyright.py:62
msgid "The year the photo was taken, from its capture date."
msgstr "O ano em que a foto foi tirada, vindo da data de captura dela."

#: src/photo_tagger/gui/copyright.py:66
msgid "The name in the Creator field above."
msgstr "O nome no campo Criador acima."

#: src/photo_tagger/gui/copyright.py:73
msgid "Leave as is"
msgstr "Deixar como está"

#: src/photo_tagger/gui/copyright.py:74
msgid "Under copyright"
msgstr "Com direitos autorais"

#: src/photo_tagger/gui/copyright.py:75
msgid "Public domain"
msgstr "Domínio público"

#: src/photo_tagger/gui/copyright.py:119
#: src/photo_tagger/gui/detail_pane.py:236
msgid "Copyright"
msgstr "Direitos autorais"

#: src/photo_tagger/gui/copyright.py:125
msgid "The model cannot know who took a photo or who owns it."
msgstr "O modelo não tem como saber quem fez a foto nem de quem ela é."

#: src/photo_tagger/gui/copyright.py:127
#, python-brace-format
msgid ""
"Use {year} for the year that photo was taken, and {artist} for the name "
"below."
msgstr ""
"Use {year} para o ano em que a foto foi tirada e {artist} para o nome "
"abaixo."

#: src/photo_tagger/gui/copyright.py:179
msgid "Your name"
msgstr "Seu nome"

#: src/photo_tagger/gui/copyright.py:181
msgid "Written to EXIF:Artist, XMP-dc:Creator, and IPTC:By-line."
msgstr "Gravado em EXIF:Artist, XMP-dc:Creator e IPTC:By-line."

#: src/photo_tagger/gui/copyright.py:185
#, python-brace-format
msgid "Copyright (c) {year} {artist}, All rights reserved"
msgstr "Copyright (c) {year} {artist}, Todos os direitos reservados"

#: src/photo_tagger/gui/copyright.py:188
msgid "Written to EXIF:Copyright, IPTC:CopyrightNotice, and XMP-dc:Rights."
msgstr "Gravado em EXIF:Copyright, IPTC:CopyrightNotice e XMP-dc:Rights."

#: src/photo_tagger/gui/copyright.py:191
msgid "(same as the notice)"
msgstr "(igual ao aviso)"

#: src/photo_tagger/gui/copyright.py:194
msgid ""
"XMP-dc:Rights on its own, for when it should read differently: XMP is "
"UTF-8, so a real copyright sign is safe there."
msgstr ""
"Apenas XMP-dc:Rights, para quando ele precisa ficar diferente: XMP é "
"UTF-8, então o símbolo © é seguro ali."

#: src/photo_tagger/gui/copyright.py:198
msgid "Creator"
msgstr "Criador"

#: src/photo_tagger/gui/copyright.py:199
msgid "Copyright notice"
msgstr "Aviso de direitos autorais"

#: src/photo_tagger/gui/copyright.py:200
msgid "XMP rights"
msgstr "Direitos XMP"

#: src/photo_tagger/gui/copyright.py:207
msgid "XMP-xmpRights:Marked, the flag that says the photo is under copyright."
msgstr "XMP-xmpRights:Marked, a marca que diz que a foto tem direitos autorais."

#: src/photo_tagger/gui/copyright.py:209
msgid "Rights flag"
msgstr "Marca de direitos"

#: src/photo_tagger/gui/copyright.py:211
msgid "Keep the name and notice a photo already has"
msgstr "Manter o nome e o aviso que a foto já tem"

#: src/photo_tagger/gui/copyright.py:215
msgid ""
"A photo with a creator keeps it, and one with a notice keeps the notice, "
"the XMP rights, and the flag. Uncheck to replace them."
msgstr ""
"Uma foto com autor o mantém, e uma com aviso mantém o aviso, os direitos "
"XMP e a marca. Desmarque para substituí-los."

#: src/photo_tagger/gui/copyright.py:236
msgid "Insert:"
msgstr "Inserir:"

#: src/photo_tagger/gui/detail_pane.py:123
msgid "Select a photo to preview it."
msgstr "Selecione uma foto para visualizá-la."

#: src/photo_tagger/gui/detail_pane.py:129
msgid "Click the photo to open it full size, where it can be zoomed and panned."
msgstr "Clique na foto para abri-la em tamanho real, onde dá para ampliar e mover."

#: src/photo_tagger/gui/detail_pane.py:148
msgid "Existing"
msgstr "Existente"

#: src/photo_tagger/gui/detail_pane.py:153
msgid ""
"Where the existing metadata was read from: the image file, an XMP "
"sidecar, or both."
msgstr ""
"De onde os metadados existentes foram lidos: do arquivo de imagem, de um "
"sidecar XMP ou de ambos."

#: src/photo_tagger/gui/detail_pane.py:163
msgid "New (editable)"
msgstr "Novo (editável)"

#: src/photo_tagger/gui/detail_pane.py:168
msgid ""
"The generated text mixes writing systems. That is right when the photo "
"shows that text, and a word the model failed to translate when it does "
"not."
msgstr ""
"O texto gerado mistura sistemas de escrita. Isso está certo quando a foto"
" mostra esse texto, e é uma palavra que o modelo deixou de traduzir "
"quando não mostra."

#: src/photo_tagger/gui/detail_pane.py:179
msgid "The title to write. Edit freely before saving."
msgstr "O título a gravar. Edite à vontade antes de salvar."

#: src/photo_tagger/gui/detail_pane.py:180
#: src/photo_tagger/gui/save_options.py:65
msgid "Title"
msgstr "Título"

#: src/photo_tagger/gui/detail_pane.py:191
msgid "The description to write."
msgstr "A descrição a gravar."

#: src/photo_tagger/gui/detail_pane.py:196
#: src/photo_tagger/gui/save_options.py:70
msgid "Description"
msgstr "Descrição"

#: src/photo_tagger/gui/detail_pane.py:205
msgid "One per line. Use < for hierarchy (Duck<Bird<Animal)"
msgstr "Uma por linha. Use < para hierarquia (Pato<Ave<Animal)"

#: src/photo_tagger/gui/detail_pane.py:208
msgid ""
"Keywords to write, one per line. Use '<' for a hierarchy (e.g. "
"'Duck<Bird<Animal'); the changes and resulting paths show below."
msgstr ""
"Palavras-chave a gravar, uma por linha. Use '<' para hierarquia (p. ex. "
"'Pato<Ave<Animal'); as mudanças e os caminhos resultantes aparecem "
"abaixo."

#: src/photo_tagger/gui/detail_pane.py:213
#: src/photo_tagger/gui/save_options.py:77
msgid "Keywords"
msgstr "Palavras-chave"

#: src/photo_tagger/gui/detail_pane.py:232
msgid ""
"The notice a save writes on this photo, dated by the year it was taken. "
"Change it in Settings > Copyright."
msgstr ""
"O aviso que uma gravação coloca nesta foto, com o ano em que ela foi "
"tirada. Altere-o em Configurações > Direitos autorais."

#: src/photo_tagger/gui/detail_pane.py:244
msgid "Keyword changes"
msgstr "Mudanças de palavras-chave"

#: src/photo_tagger/gui/detail_pane.py:250
msgid ""
"Show exactly what saving will change: added and removed keywords, plus "
"the resulting keyword tree."
msgstr ""
"Mostra exatamente o que salvar vai mudar: palavras-chave adicionadas e "
"removidas, mais a árvore de palavras-chave resultante."

#: src/photo_tagger/gui/detail_pane.py:265
msgid "Keyword changes a save will make: green added, red removed."
msgstr ""
"Mudanças de palavras-chave que salvar fará: verde adicionada, vermelho "
"removida."

#: src/photo_tagger/gui/detail_pane.py:271
msgid ""
"The keyword tree that saving will write (stored as Lightroom hierarchy "
"paths)."
msgstr ""
"A árvore de palavras-chave que salvar gravará (armazenada como caminhos "
"de hierarquia do Lightroom)."

#: src/photo_tagger/gui/detail_pane.py:274
msgid "Changes"
msgstr "Mudanças"

#: src/photo_tagger/gui/detail_pane.py:275
msgid "Tree"
msgstr "Árvore"

#: src/photo_tagger/gui/detail_pane.py:291
msgid "Hint for the AI"
msgstr "Dica para a IA"

#: src/photo_tagger/gui/detail_pane.py:293
msgid "e.g. 'The animal is a deer, not a boar'"
msgstr "ex.: 'O animal é um veado, não um javali'"

#: src/photo_tagger/gui/detail_pane.py:297
msgid ""
"A note about this photo that the model trusts over its own reading of the"
" image; useful when it misidentifies the subject. It is sent along on "
"every generation of this photo (a hinted photo skips the cached result) "
"and is never written to the file. Press Enter to regenerate right away."
msgstr ""
"Uma nota sobre esta foto na qual o modelo confia mais do que na própria "
"leitura da imagem; útil quando ele identifica o assunto errado. É enviada"
" em toda geração desta foto (uma foto com dica ignora o resultado em "
"cache) e nunca é gravada no arquivo. Pressione Enter para gerar "
"novamente."

#: src/photo_tagger/gui/detail_pane.py:313
#: src/photo_tagger/gui/main_window.py:2087
msgid "Generate This Photo"
msgstr "Gerar Esta Foto"

#: src/photo_tagger/gui/detail_pane.py:315
#: src/photo_tagger/gui/main_window.py:2090
msgid "Run the model on just this photo, regardless of which photos are checked."
msgstr ""
"Executa o modelo só nesta foto, independentemente de quais fotos estão "
"marcadas."

#: src/photo_tagger/gui/detail_pane.py:324
msgid "Generate This Photo (Skip Cache)"
msgstr "Gerar Esta Foto (Ignorar Cache)"

#: src/photo_tagger/gui/detail_pane.py:327
msgid "One-time: call the model even when a cached result exists."
msgstr "Uma única vez: chama o modelo mesmo quando existe um resultado em cache."

#: src/photo_tagger/gui/detail_pane.py:339
msgid "Save This Photo"
msgstr "Salvar Esta Foto"

#: src/photo_tagger/gui/detail_pane.py:361
#, python-brace-format
msgid "(from {sources})"
msgstr "(de {sources})"

#: src/photo_tagger/gui/detail_pane.py:361
