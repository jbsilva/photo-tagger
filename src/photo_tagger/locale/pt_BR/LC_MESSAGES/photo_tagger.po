msgid "Left as it is, a run works flat out."
msgstr "Como está, a execução trabalha sem parar."

#: src/photo_tagger/gui_state.py:1658
#, python-brace-format, python-format
msgid ""
"Works {percent}% of the time: about {rest} of rest after every {work} of "
"work."
msgstr ""
"Trabalha {percent}% do tempo: cerca de {rest} de descanso a cada {work} "
"de trabalho."

#: src/photo_tagger/gui_state.py:1668
#, python-brace-format
msgid ""
"Whenever the battery falls to {floor}%, rests until it is back to "
"{resume}%, for at most {cap}."
msgstr ""
"Sempre que a bateria cair a {floor}%, descansa até voltar a {resume}%, "
"por no máximo {cap}."

#: src/photo_tagger/gui_state.py:1679
#, python-brace-format
msgid ""
"{mark} A plugged-in laptop is rarely that full, so the run would rest "
"after nearly every window and wait out the cap each time."
msgstr ""
"{mark} Um notebook na tomada raramente está tão cheio, então a execução "
"descansaria depois de quase toda janela e esperaria o limite acabar todas"
" as vezes."

