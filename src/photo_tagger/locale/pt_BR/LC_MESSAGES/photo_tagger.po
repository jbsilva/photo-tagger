#, python-brace-format
msgid ""
"Generation failed: {error}\n"
"Use 'Retry Failed' to try again, or Help > Open Logs for the full "
"traceback."
msgstr ""
"A geração falhou: {error}\n"
"Use 'Repetir Falhas' para tentar novamente, ou Ajuda > Abrir Logs para o "
"traceback completo."

#: src/photo_tagger/gui/detail_pane.py:450
