msgstr "título"

#: src/photo_tagger/gui.py:3985 src/photo_tagger/gui.py:4023
#: src/photo_tagger/gui_state.py:1856
msgid "description"
msgstr "descrição"

#: src/photo_tagger/gui.py:3991
msgid "your copyright"
msgstr "seus direitos autorais"

#: src/photo_tagger/gui.py:3992
