msgstr "Mostra apenas as fotos no estado escolhido."

#: src/photo_tagger/gui.py:3530
msgid "Sort by"
msgstr "Ordenar por"

#: src/photo_tagger/gui.py:3533
msgid "Name"
msgstr "Nome"

#: src/photo_tagger/gui.py:3540
