msgstr "Começar a Monitorar"

#: src/photo_tagger/gui.py:6910
msgid "(pick a folder)"
msgstr "(escolha uma pasta)"

#: src/photo_tagger/gui.py:6916
msgid "Folder"
msgstr "Pasta"

