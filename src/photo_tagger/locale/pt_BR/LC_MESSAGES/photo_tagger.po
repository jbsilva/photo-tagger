msgstr "Exportações de palavras-chave (*.txt *.csv);;Todos os arquivos (*)"

#: src/photo_tagger/gui.py:6430
msgid "Write the vocabulary to"
msgstr "Gravar o vocabulário em"

#: src/photo_tagger/gui.py:6432
msgid "Keyword files (*.txt);;All files (*)"
msgstr "Arquivos de palavras-chave (*.txt);;Todos os arquivos (*)"

#: src/photo_tagger/gui.py:6441
